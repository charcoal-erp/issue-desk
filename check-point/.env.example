# Checkpoint — test management. Runs per test machine / developer / environment,
# pointed at a git-versioned content repo (e.g. charcoal's platform-testing).

# Where this Checkpoint's content lives: tests/, suites/, runs/, runners.json,
# reports/ and config/ (its own applications + users). Point it at a content
# repo checkout, or let it seed an empty catalogue here.
DATA_DIR=./checkpoint-data

# Base for the runner working directories (a runner's workingDir is resolved
# against this). Usually the code root the tests run against.
# CHECKPOINT_WORKDIR=/home/you/projects/charcoal/code

PORT=5174
WATCH_FILES=false

# --- Optional IssueDesk integration ---------------------------------------
# When set, "file a bug" from a failure POSTs to this IssueDesk, issue links
# resolve over HTTP, and the parent-issue picker is available. Unset = fully
# standalone: failures export as a Claude Code prompt / Markdown / JSON only.
# ISSUEDESK_URL=http://localhost:5173

# Sent as a bearer token to IssueDesk if it requires one (ISSUEDESK_INGEST_TOKEN).
# ISSUEDESK_TOKEN=
