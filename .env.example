# IssueDesk — the central issue tracker (one instance, shared by everyone).

# Where issues, config and uploads live.
DATA_DIR=./data

# Absolutises attachment URLs in exports.
PUBLIC_BASE_URL=http://localhost:5173

# The URL the built server (`node build`) is served from. adapter-node rejects
# form posts — the login form included — whose Origin does not match it. Not
# used by `vite dev`. Set it to the same value as PUBLIC_BASE_URL.
# ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=15
MAX_ATTACHMENTS=10
WATCH_FILES=false
PORT=5173

# --- Authentication --------------------------------------------------------
# Signing secret for session cookies and API tokens. Left unset, one is
# generated on first boot and persisted to data/auth/jwt-secret.json — fine for
# a single instance. SET THIS EXPLICITLY if you run more than one, or they will
# generate different secrets and reject each other's tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# AUTH_JWT_SECRET=

# How long an issued token stays valid.
# AUTH_TOKEN_TTL_HOURS=12

# Password for the bootstrap admin, used ONLY on a first boot with no accounts
# yet. Unset = a strong one is generated and printed to the server log once.
# ISSUEDESK_ADMIN_PASSWORD=

# --- Optional Checkpoint link ---------------------------------------------
# When set, an issue filed from a test shows a "view test case" link into that
# Checkpoint instance. Unset = no cross-link (issues still stand alone).
# CHECKPOINT_URL=http://localhost:5174

# Legacy ingest path: when set, POST /api/issues also accepts this bearer token
# instead of a login, so an existing Checkpoint keeps filing bugs. Unset = that
# route needs a token like every other, from POST /api/auth/login.
# ISSUEDESK_INGEST_TOKEN=

# --- Generative AI (issue refinement + tag suggestions) -------------------
# Base64-encoded 32-byte key that encrypts the provider-key vault
# (data/vault/*.json). Required before you can save a key via Config → Keys.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEY_ENCRYPTION_KEY=

# Optional fallback Anthropic key for local dev. A key added in Config → Keys
# (encrypted, in the vault) always takes precedence over this.
# ANTHROPIC_API_KEY=sk-ant-...
