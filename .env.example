# IssueDesk — the central issue tracker (one instance, shared by everyone).

# Where issues, config and uploads live.
DATA_DIR=./data

# Absolutises attachment URLs in exports.
PUBLIC_BASE_URL=http://localhost:5173

MAX_UPLOAD_MB=15
MAX_ATTACHMENTS=10
WATCH_FILES=false
PORT=5173

# --- Optional Checkpoint link ---------------------------------------------
# When set, an issue filed from a test shows a "view test case" link into that
# Checkpoint instance. Unset = no cross-link (issues still stand alone).
# CHECKPOINT_URL=http://localhost:5174

# When set, POST /api/issues requires this bearer token — so only a trusted
# Checkpoint (or the simulators) can file issues. Unset = open on the LAN.
# ISSUEDESK_INGEST_TOKEN=

# --- Generative AI (issue refinement + tag suggestions) -------------------
# Base64-encoded 32-byte key that encrypts the provider-key vault
# (data/vault/*.json). Required before you can save a key via Config → Keys.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEY_ENCRYPTION_KEY=

# Optional fallback Anthropic key for local dev. A key added in Config → Keys
# (encrypted, in the vault) always takes precedence over this.
# ANTHROPIC_API_KEY=sk-ant-...
