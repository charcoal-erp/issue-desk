# Loaded by Vite in `test` mode, ahead of .env — keeps `npm test` away from the
# real data dir. Must match test.env.DATA_DIR in vite.config.ts.
DATA_DIR=/tmp/issuedesk-vitest-data
WATCH_FILES=false
# Deterministic 32-byte base64 KEK so the vault tests can encrypt/decrypt.
KEY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
